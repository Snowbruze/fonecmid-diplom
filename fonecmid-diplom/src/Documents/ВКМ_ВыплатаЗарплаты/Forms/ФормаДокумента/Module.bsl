
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьТекущуюЗадолженность(Команда)
	
	ЗаполнитьТекущуюЗадолженностьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТекущуюЗадолженностьНаСервере()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьТекущуюЗадолженность();
	ЗначениеВДанныеФормы(ДокументОбъект, Объект); 

КонецПроцедуры

#КонецОбласти