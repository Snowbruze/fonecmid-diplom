Функция ПолучитьДанныеДокументовДляАктов(МассивОбъектов)
	
	//++ a.demeshchenko 01.01.2025 netology Дипломный проект
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Дата,
		|	РеализацияТоваровУслуг.Номер,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(РеализацияТоваровУслуг.Организация) КАК Организация,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(РеализацияТоваровУслуг.Контрагент) КАК Контрагент,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(РеализацияТоваровУслуг.Договор) КАК Договор,
		|	РеализацияТоваровУслуг.Товары.(
		|		Номенклатура,
		|		Количество,
		|		Цена,
		|		Сумма),
		|	РеализацияТоваровУслуг.Услуги.(
		|		Номенклатура,
		|		Количество,
		|		Цена,
		|		Сумма),
		|	РеализацияТоваровУслуг.СуммаДокумента,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(РеализацияТоваровУслуг.Ответственный) КАК Ответственный,
		|	РеализацияТоваровУслуг.Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.Ссылка В (&МассивОбъектов)";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Возврат Запрос.Выполнить().Выбрать();
	//-- a.demeshchenko 01.01.2025 netology Дипломный проект
	
КонецФункции

Процедура ВывестиЗаголовокАкта(ДанныеДокументов, ТабличныйДокумент, Макет)
	
	//++ a.demeshchenko 01.01.2025 netology Дипломный проект
	ОбластьЗаголовокАкта = Макет.ПолучитьОбласть("Заголовок");
	
	ОбластьЗаголовокАкта.Параметры.Номер = ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(ДанныеДокументов.Номер);
	ОбластьЗаголовокАкта.Параметры.ДатаДокумента = Формат(ДанныеДокументов.Дата, "ДФ=dd.MM.yyyy;");
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовокАкта);
	//-- a.demeshchenko 01.01.2025 netology Дипломный проект
	
КонецПроцедуры

Процедура ВывестиРеквизитыАкта(ДанныеДокументов, ТабличныйДокумент, Макет)
	
	//++ a.demeshchenko 01.01.2025 netology Дипломный проект
	ОбластьРеквитизы = Макет.ПолучитьОбласть("Реквизиты");
	
	ДанныеПечати = Новый Структура;
	ДанныеПечати.Вставить("Контрагент", ДанныеДокументов.Контрагент);
	ДанныеПечати.Вставить("Организация", ДанныеДокументов.Организация);
	ДанныеПечати.Вставить("Договор", ДанныеДокументов.Договор);
	
	ОбластьРеквитизы.Параметры.Заполнить(ДанныеПечати);
	ТабличныйДокумент.Вывести(ОбластьРеквитизы);
	//-- a.demeshchenko 01.01.2025 netology Дипломный проект
	
КонецПроцедуры

Процедура ВывестиТовары(ДанныеДокументов, ТабличныйДокумент, Макет)
	
	//++ a.demeshchenko 01.01.2025 netology Дипломный проект
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ТоварыШапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("ТоварыСтрока");
	ОбластьИтого = Макет.ПолучитьОбласть("Итог");
	
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	
	ВыборкаТовары = ДанныеДокументов.Товары.Выбрать();
	Пока ВыборкаТовары.Следующий() Цикл
		ОбластьСтрока.Параметры.Заполнить(ВыборкаТовары);
		ТабличныйДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	ВыборкаУслуги = ДанныеДокументов.Услуги.Выбрать();
	Пока ВыборкаУслуги.Следующий() Цикл
		ОбластьСтрока.Параметры.Заполнить(ВыборкаУслуги);
		ТабличныйДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	ДанныеПечати = Новый Структура;
	ДанныеПечати.Вставить("СуммаДокумента", ДанныеДокументов.СуммаДокумента);
	ОбластьИтого.Параметры.Заполнить(ДанныеПечати);
	
	ТабличныйДокумент.Вывести(ОбластьИтого);
	//-- a.demeshchenko 01.01.2025 netology Дипломный проект
	
КонецПроцедуры

Процедура ВывестиПодвалАкта(ДанныеДокументов, ТабличныйДокумент, Макет)
	
	//++ a.demeshchenko 01.01.2025 netology Дипломный проект
	ОбластьПодвалСчета = Макет.ПолучитьОбласть("Подвал");
	
	ДанныеПечати = Новый Структура;
	ДанныеПечати.Вставить("Ответственный", ДанныеДокументов.Ответственный);
	ОбластьПодвалСчета.Параметры.Заполнить(ДанныеПечати);
	
	ТабличныйДокумент.Вывести(ОбластьПодвалСчета);
	//-- a.demeshchenko 01.01.2025 netology Дипломный проект
	
КонецПроцедуры

